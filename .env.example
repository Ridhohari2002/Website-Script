# BOYFINITY Hub — environment template
# Copy to .env.local and fill in locally. NEVER commit real secrets.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string. Required at runtime; not required for `next build`.
# Example (local): postgresql://postgres:postgres@localhost:5432/boyfinity
DATABASE_URL=
# Connection pool size per process. Optional; defaults to 10.
DATABASE_POOL_MAX=10
# Test-only database for the real-PostgreSQL concurrency suite. Never point this
# at boyfinity_dev. Leave unset unless running the dedicated integration test.
# BOYFINITY_CONCURRENCY_TEST_DATABASE_URL=postgresql://USER@localhost:5432/boyfinity_concurrency_test

# --- Security secrets --------------------------------------------------------
# Dedicated key used to derive privacy-preserving rate-limit bucket identifiers
# (HMAC-SHA-256). Required in production. A development-only default is used
# when NODE_ENV != production.
RATE_LIMIT_HMAC_SECRET=
# Optional key-version tag so identifiers can be rotated without collision.
RATE_LIMIT_HMAC_KEY_VERSION=v1
# Dedicated key for hashing session tokens and OAuth state, and for deriving the
# per-session CSRF token (HMAC-SHA-256). Minimum 16 characters. Required in
# production; a development-only default is used otherwise. Rotating it signs
# out every existing session. Never expose it to browser code.
SESSION_HMAC_SECRET=

# --- Discord OAuth 2.0 -------------------------------------------------------
# Authorization Code + PKCE (S256), scope `identify`. All three are optional at
# boot so `next build` never needs credentials; `GET /api/auth/login` fails with
# 503 when they are missing. Use placeholder values locally.
#   DISCORD_CLIENT_ID     - application/client id (Discord snowflake)
#   DISCORD_CLIENT_SECRET - server-only; never commit or expose to the browser
#   DISCORD_REDIRECT_URI  - must exactly equal ${APP_URL}/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Primary owner's Discord user id (snowflake). Optional; leave empty to disable
# owner identification. The server compares it only against the verified
# `users.discord_id` of an authenticated session, never against client input.
# The owner role is derived per request and is not stored in the database.
DISCORD_OWNER_ID=

# --- Midtrans (SANDBOX ONLY) -------------------------------------------------
# Sandbox is approved for development/testing only.
# Production merchant eligibility is PENDING_PROVIDER_RESPONSE.
# Production payment acceptance is NOT AUTHORIZED.
# The Server Key is server-only: never expose it to browser code, never log it.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Must stay false. Setting true is a production action and is not authorized.
MIDTRANS_IS_PRODUCTION=false

# --- App ---------------------------------------------------------------------
# Public base URL used for redirect validation in later phases.
APP_URL=http://localhost:3000
